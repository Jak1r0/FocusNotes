{
  "name": "focusnotes",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "apps/desktop",
    "apps/mobile"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @focusnotes/desktop",
    "build": "npm run build -w @focusnotes/core && npm run build -w @focusnotes/desktop",
    "test": "npm run test -w @focusnotes/core",
    "typecheck": "npm run build -w @focusnotes/core && npm run typecheck -w @focusnotes/desktop && npm run typecheck -w @focusnotes/mobile"
  },
  "devDependencies": {
    "@babel/runtime": "^8.1.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-win32-x64-msvc": "4.68.5"
  },
  "dependencies": {
    "@react-native-community/slider": "^4.5.1",
    "react-native-pager-view": "^6.4.1",
    "react-native-svg": "15.8.0"
  }
}
